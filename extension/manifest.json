{
  "manifest_version": 3,
  "name": "eko Fresh",
  "version": "1.0.0",
  "description": "חפשו מוצרים בטיב טעם ושלחו בקשה ישירות למנהל המשרד.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.tivtaam.co.il/*",
    "https://office-shopping-nine.vercel.app/*"
  ]
}
